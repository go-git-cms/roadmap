# Copy to .env for local development. Production reads the same names from the
# environment (Railway service variables); nothing here is baked into the build.

# --- Where the roadmap runs ---------------------------------------------------
# This site's public origin. Required for sign-in: it is what the PKCE
# redirect_uri is built from. Off in dev means the site renders signed out.
ROADMAP_PUBLIC_URL=http://localhost:4350

# --- The CMS ------------------------------------------------------------------
# The CMS origin serving /api/v1 (the auth issuer) and /api/content/v1 (the
# form API). One origin for both in every deployment so far.
ROADMAP_CMS_URL=http://localhost:8080

# IMPORTANT: the CMS must be told to trust ROADMAP_PUBLIC_URL as a redirect
# target, or /api/v1/auth/authorize refuses to mint a code for it. Add it to
# CMS_DOCS_URL on the CMS deployment — a comma-separated list of first-party
# origins, e.g. CMS_DOCS_URL=https://gogitcms.com,https://roadmap.gogitcms.com

# HMAC key for the roadmap's own signed, HttpOnly session cookie. Generate with
#   openssl rand -base64 48
# Rotating it signs everyone out of the roadmap; it does not touch CMS sessions.
ROADMAP_SESSION_SECRET=

# --- The endorsement store ------------------------------------------------------
# Which repository and project hold the `roadmap-endorsement` form (this file's
# sibling go-git-cms.yml). owner/repo is the address of the config, not a
# credential. Inside the monorepo the project is `roadmap`; a copy of this site
# in its own repository is single-project and can leave ROADMAP_CMS_PROJECT
# empty.
ROADMAP_CMS_REPO=go-git-cms/gogitcms
ROADMAP_CMS_PROJECT=roadmap
# Which branch's form to use. Empty means the repository's default branch.
ROADMAP_CMS_REF=

# A content token (Repository settings → Content tokens) that assumes the
# `editor` role WITH write scope. It is the only credential that touches the
# form API: the browser never sees it, and it is what lets the site submit on a
# signed-in visitor's behalf, read every submission back to aggregate the
# public counts, and delete one when a visitor withdraws. Without it the board
# renders with counts unavailable and voting is disabled.
ROADMAP_CMS_TOKEN=

# --- Build provenance ---------------------------------------------------------
# The commit the footer names. Railway sets RAILWAY_GIT_COMMIT_SHA, which is
# read as a fallback; locally the site asks git itself.
ROADMAP_COMMIT_SHA=

# --- Preview ------------------------------------------------------------------
# Must match the value the CMS signs preview payloads with. Unset (local dev)
# the middleware accepts unsigned payloads and says so on every request.
CMS_PREVIEW_SECRET=

# Editor origins allowed to exchange drafts with this page, on top of the
# site's own origin (the bundled /admin editor). Build-time, comma-separated.
PUBLIC_CMS_EDITOR_ORIGINS=http://localhost:5173
